---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Hero from '../components/sections/Hero.astro';
import CapabilityStrip from '../components/sections/CapabilityStrip.astro';
import Principles from '../components/sections/Principles.astro';
import Features from '../components/sections/Features.astro';
import Looks from '../components/sections/Looks.astro';
import EarlyAccess from '../components/sections/EarlyAccess.astro';
---

<Layout
  title="Iris — Open-source, control-first iPhone camera"
  description="Iris is an open-source iPhone camera app with direct manual control and live looks—built in the open."
>
  <div class="site-frame">
    <SiteHeader />

    <main id="top">
      <Hero />
      <CapabilityStrip />
      <Principles />
      <Features />
      <Looks />
      <EarlyAccess />
    </main>

    <SiteFooter />
  </div>

  <script>
    import { initPageMotion } from '../scripts/page-motion';
    import { initCameraDemo } from '../scripts/camera-demo';

    initPageMotion();
    initCameraDemo();
  </script>
</Layout>
