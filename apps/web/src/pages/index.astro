---
import Layout from '../layouts/Layout.astro';

const controls = [
  { value: '1/250', label: 'Shutter' },
  { value: '200', label: 'ISO' },
  { value: '5200K', label: 'White balance' },
];

const features = [
  {
    number: '01',
    title: 'Manual, without the maze',
    copy: 'Control shutter speed, ISO, focus, white balance, and exposure from one calm, tactile interface.',
  },
  {
    number: '02',
    title: 'See the look before the shot',
    copy: 'Original Iris Looks render live, so the photograph you frame is the photograph you keep.',
  },
  {
    number: '03',
    title: 'Your file, your choice',
    copy: 'Capture a finished HEIC for the moment or keep the full flexibility of RAW when the scene deserves it.',
  },
];
---

<Layout
  title="Iris — Photography, in your hands"
  description="Iris is a manual camera for iPhone with direct photographic controls and original live looks."
>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="Iris home">
      <span class="aperture-mark" aria-hidden="true"></span>
      IRIS
    </a>
    <nav aria-label="Primary navigation">
      <a href="#features">Features</a>
      <a href="#principles">Why Iris</a>
    </nav>
    <a class="header-cta" href="#early-access">Early access</a>
  </header>

  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">A camera for iPhone</p>
        <h1>Photography,<br /><em>in your hands.</em></h1>
        <p class="hero-intro">
          Direct control when you want it. A finished photograph when you
          don’t. Iris turns your iPhone into a camera that rewards intention.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#features">Explore Iris</a>
          <span class="availability">Coming first to iPhone</span>
        </div>
      </div>

      <div class="camera-stage" aria-label="Preview of the Iris camera interface">
        <div class="phone">
          <div class="phone-screen">
            <div class="viewfinder">
              <div class="viewfinder-sky"></div>
              <div class="viewfinder-horizon"></div>
              <div class="viewfinder-subject"></div>
              <span class="focus-box" aria-hidden="true"></span>
              <div class="camera-topbar">
                <span>RAW</span>
                <span>AUTO</span>
                <span>•••</span>
              </div>
              <div class="look-label">
                <span>IRIS LOOK</span>
                <strong>DAYLIGHT</strong>
              </div>
            </div>
            <div class="camera-controls">
              <div class="control-values">
                {controls.map((control) => (
                  <div>
                    <span>{control.label}</span>
                    <strong>{control.value}</strong>
                  </div>
                ))}
              </div>
              <div class="focal-lengths" aria-hidden="true">
                <span>24</span>
                <strong>35</strong>
                <span>50</span>
              </div>
              <div class="shutter-row">
                <span class="thumbnail"></span>
                <span class="shutter"></span>
                <span class="switch-camera">↻</span>
              </div>
            </div>
          </div>
        </div>
        <p class="stage-note">Designed around the photograph—not the interface.</p>
      </div>
    </section>

    <section class="statement" id="principles">
      <p class="eyebrow">The Iris approach</p>
      <blockquote>
        “A powerful camera should make you more present, not more distracted.”
      </blockquote>
      <p>
        Iris keeps automatic capture immediate and reveals deeper controls only
        when you reach for them.
      </p>
    </section>

    <section class="features" id="features">
      <div class="section-heading">
        <p class="eyebrow">Made for the frame</p>
        <h2>Everything essential.<br />Nothing between you and the moment.</h2>
      </div>
      <div class="feature-list">
        {features.map((feature) => (
          <article class="feature">
            <span>{feature.number}</span>
            <h3>{feature.title}</h3>
            <p>{feature.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="looks">
      <div class="looks-copy">
        <p class="eyebrow">Original Iris Looks</p>
        <h2>Color with<br /><em>a point of view.</em></h2>
        <p>
          Five considered renderings—from quiet and natural to crisp
          monochrome—shown live in the viewfinder and applied with care to the
          final image.
        </p>
      </div>
      <div class="look-swatches" aria-label="Iris Look examples">
        <div class="swatch swatch-natural"><span>Natural</span></div>
        <div class="swatch swatch-daylight"><span>Daylight</span></div>
        <div class="swatch swatch-noir"><span>Noir</span></div>
      </div>
    </section>

    <section class="early-access" id="early-access">
      <div>
        <p class="eyebrow">In development</p>
        <h2>The first frame<br />is coming.</h2>
      </div>
      <div class="early-copy">
        <p>
          Iris is being built for photographers who want their phone to feel
          more like a camera. Early access details will be announced here.
        </p>
        <span class="status-pill"><i></i> iPhone beta planned</span>
      </div>
    </section>
  </main>

  <footer>
    <a class="wordmark" href="/" aria-label="Iris home">
      <span class="aperture-mark" aria-hidden="true"></span>
      IRIS
    </a>
    <p>Photography, in your hands.</p>
    <p>© {new Date().getFullYear()} Iris</p>
  </footer>
</Layout>
