---
import Layout from '../layouts/Layout.astro';

const capabilities = [
  ['01', 'Direct control', 'Shutter, ISO, focus, white balance, and exposure—without leaving the frame.'],
  ['02', 'Live Iris Looks', 'See the final character of your photograph before you press the shutter.'],
  ['03', 'Files with a future', 'Keep a finished HEIC for now or a flexible RAW file for what comes next.'],
];

const looks = [
  {
    name: 'Natural',
    description: 'Quiet color. Honest light.',
    className: 'natural',
    image: '/images/look-natural.jpg',
    alt: 'A cyclist passing a concrete wall beneath soft tree shadows',
  },
  {
    name: 'Daylight',
    description: 'Warm highlights. Clean blues.',
    className: 'daylight',
    image: '/images/look-daylight.jpg',
    alt: 'A person in red ascending a sunlit coastal stairway',
  },
  {
    name: 'Noir',
    description: 'Soft silver. Deep blacks.',
    className: 'noir',
    image: '/images/look-noir.jpg',
    alt: 'A solitary figure standing beneath a rain-darkened railway overpass',
  },
];
---

<Layout
  title="Iris — A camera with a point of view"
  description="Iris is a private, focused camera for iPhone with direct manual controls and original live looks."
>
  <div class="site-frame">
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Iris home">
        <span class="iris-mark" aria-hidden="true"></span>
        <span>IRIS</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#features">Features</a>
        <a href="#looks">Iris Looks</a>
        <a href="#principles">Why Iris</a>
      </nav>

      <a class="button button-dark header-cta" href="#early-access">
        Get early access <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Camera, reconsidered</p>
          <h1 id="hero-title">
            The frame comes first.<br />
            <span>You control the rest.</span>
          </h1>
          <p class="hero-intro">
            A focused iPhone camera for fast automatic capture, precise manual control,
            and original looks you can see before the shot.
          </p>
          <div class="hero-actions">
            <a class="button button-light" href="#early-access">
              Get early access <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-ghost" href="#features">Explore Iris</a>
          </div>
        </div>

        <div class="hero-visual" aria-label="A preview of the Iris camera interface">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="orbit orbit-three"></div>
          <div class="red-glow"></div>

          <div class="floating-chip chip-look">
            <span class="chip-dot"></span>
            <span><small>IRIS LOOK</small> NATURAL</span>
          </div>
          <div class="floating-chip chip-raw">
            <span><small>FORMAT</small> RAW + HEIC</span>
          </div>

          <div class="phone">
            <div class="phone-bezel">
              <div class="phone-screen">
                <div class="phone-status">
                  <div class="mini-brand"><span class="mini-mark"></span> IRIS</div>
                  <span class="camera-state"><i></i> BACK</span>
                  <span class="frame-count"><strong>36</strong><small>FRAMES</small></span>
                </div>

                <div class="viewfinder">
                  <img
                    class="viewfinder-photo"
                    src="/images/iris-hero.jpg"
                    alt=""
                    width="1024"
                    height="1536"
                  />
                  <div class="grid-lines" aria-hidden="true"></div>
                  <div class="preview-label"><i></i> STYLE PREVIEW</div>
                  <div class="exposure-pill"><span>1/125</span><i></i><span>ISO 64</span></div>
                  <div class="focus-reticle"><i></i></div>
                  <div class="lens-rail">
                    <span>24</span><span>28</span><strong>35</strong><span>50</span><small>MM</small>
                  </div>
                </div>

                <div class="control-deck">
                  <div class="mode-switch">
                    <span class="active">PHOTO<i></i></span><span>MANUAL</span>
                  </div>
                  <div class="tool-row">
                    <span><i>◫</i><strong>HEIC</strong><small>FORMAT</small></span>
                    <span><i>ϟ</i><strong>OFF</strong><small>FLASH</small></span>
                    <span><i>◎</i><strong>AUTO</strong><small>FOCUS</small></span>
                    <span><i>▦</i><strong>3 × 3</strong><small>GRID</small></span>
                  </div>
                  <div class="capture-row">
                    <span class="look-control"><i></i><b><small>IRIS LOOK</small>NATURAL</b></span>
                    <span class="shutter"><i></i></span>
                    <span class="camera-flip">↻</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <p class="visual-note"><span></span> Designed around the photograph—not the interface.</p>
        </div>
      </section>

      <div class="capability-strip" aria-label="Iris highlights">
        <p>Made for photographers who want more from the camera they always carry.</p>
        <span>Manual control</span>
        <span>Live looks</span>
        <span>HEIC + RAW</span>
        <span>Private by default</span>
      </div>

      <section class="principles" id="principles">
        <p class="section-label">01 / The Iris approach</p>
        <div>
          <p class="statement-kicker">A phone can be a real camera.</p>
          <h2>More intention.<br /><span>Less interface.</span></h2>
        </div>
        <p class="principle-copy">
          Iris stays fast when the moment is brief, then reveals direct photographic
          controls when you reach for them. No feed. No account. Nothing between you
          and the frame.
        </p>
      </section>

      <section class="features" id="features">
        <div class="section-head">
          <p class="section-label">02 / Built for the frame</p>
          <h2>Everything essential.<br /><span>Nothing extra.</span></h2>
        </div>
        <div class="feature-grid">
          {capabilities.map(([number, title, copy]) => (
            <article>
              <span class="feature-number">{number}</span>
              <div class="feature-icon" aria-hidden="true"><i></i></div>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="looks" id="looks">
        <div class="looks-copy">
          <p class="section-label">03 / Original Iris Looks</p>
          <h2>Color with<br /><span>a point of view.</span></h2>
          <p>
            A small set of considered renderings, shown live in the viewfinder and
            applied with care to the final image.
          </p>
        </div>
        <div class="look-cards">
          {looks.map((look, index) => (
            <article class={`look-card look-${look.className}`}>
              <div class="look-art">
                <img src={look.image} alt={look.alt} width="960" height="1440" loading="lazy" />
              </div>
              <div class="look-meta">
                <span>0{index + 1}</span>
                <div><h3>{look.name}</h3><p>{look.description}</p></div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="early-access" id="early-access">
        <p class="section-label">In development / iPhone first</p>
        <h2>Be there for<br /><span>the first frame.</span></h2>
        <div class="early-copy">
          <p>
            Iris is being built for photographers who want their phone to feel more
            like a camera. Early access details will be announced here.
          </p>
          <a class="button button-light" href="mailto:hello@iris.camera?subject=Iris%20early%20access">
            Join early access <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <a class="wordmark" href="#top" aria-label="Iris home">
        <span class="iris-mark" aria-hidden="true"></span><span>IRIS</span>
      </a>
      <p>Photography, in your hands.</p>
      <p>© {new Date().getFullYear()} Iris</p>
    </footer>
  </div>
</Layout>
