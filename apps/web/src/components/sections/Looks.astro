---
import { looks } from '../../data/content';
---

<section class="section looks" id="looks">
  <header class="looks-copy reveal">
    <p class="section-label">03 / Looks</p>
    <h2>Five looks.<br /><span>Shown live.</span></h2>
    <p class="section-copy">
      A small set of considered renderings—visible in the viewfinder, applied with care to the
      final file.
    </p>
  </header>

  <div class="look-rail">
    {
      looks.map((look, index) => (
        <article
          class={`look-card look-${look.className} reveal`}
          style={`--delay: ${index * 70}ms`}
        >
          <div class="look-art">
            <img
              src={look.image}
              alt={look.alt}
              width={look.width}
              height={look.height}
              loading="lazy"
            />
          </div>
          <div class="look-meta">
            <span>0{index + 1}</span>
            <div>
              <h3>{look.name}</h3>
              <p>{look.description}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
