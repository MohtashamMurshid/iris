---
interface Props {
  class?: string;
  size?: 'default' | 'mini';
}

const { class: className = '', size = 'default' } = Astro.props;
const markClass = [
  size === 'mini' ? 'mini-mark' : 'iris-mark',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<svg class={markClass} viewBox="0 0 64 64" aria-hidden="true">
  <circle
    class="mark-ring"
    cx="32"
    cy="32"
    r="19"
    fill="none"
    stroke="currentColor"
    stroke-width="9"
    stroke-dasharray="14 5"></circle>
  <circle class="mark-core" cx="32" cy="32" r="5" fill="var(--signal-red)"></circle>
</svg>
